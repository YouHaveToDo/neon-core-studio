# Copy this file to `.env` (same directory) and fill in real values.
# .env is gitignored -- never commit real credentials.

# Standard libpq-style connection string. For local dev against a
# Postgres.app / docker Postgres, something like:
#   postgresql://postgres@localhost:5432/neoncore_dev
# For Neon/Supabase, copy the connection string from their dashboard
# (it will include ?sslmode=require or similar -- the app auto-detects
# local vs. remote and toggles SSL, see src/db.js).
DATABASE_URL=postgresql://postgres@localhost:5432/neoncore_dev

# Port the HTTP server listens on.
PORT=3001

# Node env: development | production. Affects Secure cookie flag (Secure
# requires HTTPS, which local dev over plain http:// doesn't have).
NODE_ENV=development
